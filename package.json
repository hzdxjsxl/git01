{
  "name": "3d-print-gcode-viewer",
  "version": "1.0.0",
  "description": "3D Print G-code Preview Viewer with Babylon.js",
  "main": "server.js",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/app.ts --bundle --outfile=public/js/bundle.js --target=es2020 --format=iife --global-name=GcodeViewer --sourcemap",
    "watch": "esbuild src/app.ts --bundle --outfile=public/js/bundle.js --target=es2020 --format=iife --global-name=GcodeViewer --sourcemap --watch",
    "start": "node server.js",
    "dev": "npm run build && npm run bundle && npm start"
  },
  "dependencies": {
    "babylonjs": "^6.48.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.28",
    "esbuild": "^0.20.2",
    "typescript": "^5.4.2"
  }
}
