; Sample Cube G-code for testing
; Generated for 3D Print G-code Viewer
; Printer: Generic FDM
; Build plate: 200x200 mm

G21 ; Set units to millimeters
G90 ; Use absolute coordinates
M82 ; Use absolute E coordinates
M140 S60 ; Set bed temp 60C
G28 ; Home all axes
G29 ; Auto bed leveling (placeholder)
M190 S60 ; Wait for bed to reach temp
M104 S200 ; Set hotend temp
M109 S200 ; Wait for hotend temp

; Start purge line
G0 X20 Y20 Z0.3 F3000
G1 X100 Y20 Z0.3 E10 F1000
G1 X100 Y40 Z0.3 E12 F1000
G1 X20 Y40 Z0.3 E20 F1000
G0 X100 Y100 Z0.3 F3000

; Cube 40x40x40 mm at (80, 80)
; Layer 1 - Base
G0 X80 Y80 Z0.2 F3000
G1 X120 Y80 Z0.2 E2.0 F1000
G1 X120 Y120 Z0.2 E4.0 F1000
G1 X80 Y120 Z0.2 E6.0 F1000
G1 X80 Y80 Z0.2 E8.0 F1000

; Fill layer 1
G0 X85 Y85 Z0.2 F3000
G1 X115 Y85 Z0.2 E10.0 F800
G1 X115 Y115 Z0.2 E12.0 F800
G1 X85 Y115 Z0.2 E14.0 F800
G1 X85 Y85 Z0.2 E16.0 F800

; Layer 2
G0 X80 Y80 Z0.4 F3000
G1 X120 Y80 Z0.4 E18.0 F1000
G1 X120 Y120 Z0.4 E20.0 F1000
G1 X80 Y120 Z0.4 E22.0 F1000
G1 X80 Y80 Z0.4 E24.0 F1000

G0 X85 Y85 Z0.4 F3000
G1 X115 Y85 Z0.4 E26.0 F800
G1 X115 Y115 Z0.4 E28.0 F800
G1 X85 Y115 Z0.4 E30.0 F800
G1 X85 Y85 Z0.4 E32.0 F800

; Layer 3
G0 X80 Y80 Z0.6 F3000
G1 X120 Y80 Z0.6 E34.0 F1000
G1 X120 Y120 Z0.6 E36.0 F1000
G1 X80 Y120 Z0.6 E38.0 F1000
G1 X80 Y80 Z0.6 E40.0 F1000

G0 X85 Y85 Z0.6 F3000
G1 X115 Y85 Z0.6 E42.0 F800
G1 X115 Y115 Z0.6 E44.0 F800
G1 X85 Y115 Z0.6 E46.0 F800
G1 X85 Y85 Z0.6 E48.0 F800

; Layer 4
G0 X80 Y80 Z0.8 F3000
G1 X120 Y80 Z0.8 E50.0 F1000
G1 X120 Y120 Z0.8 E52.0 F1000
G1 X80 Y120 Z0.8 E54.0 F1000
G1 X80 Y80 Z0.8 E56.0 F1000

G0 X85 Y85 Z0.8 F3000
G1 X115 Y85 Z0.8 E58.0 F800
G1 X115 Y115 Z0.8 E60.0 F800
G1 X85 Y115 Z0.8 E62.0 F800
G1 X85 Y85 Z0.8 E64.0 F800

; Layer 5
G0 X80 Y80 Z1.0 F3000
G1 X120 Y80 Z1.0 E66.0 F1000
G1 X120 Y120 Z1.0 E68.0 F1000
G1 X80 Y120 Z1.0 E70.0 F1000
G1 X80 Y80 Z1.0 E72.0 F1000

G0 X85 Y85 Z1.0 F3000
G1 X115 Y85 Z1.0 E74.0 F800
G1 X115 Y115 Z1.0 E76.0 F800
G1 X85 Y115 Z1.0 E78.0 F800
G1 X85 Y85 Z1.0 E80.0 F800

; Circle pattern on top
G0 X100 Y90 Z1.2 F3000
G2 X100 Y90 Z1.2 I0 J10 E85.0 F500

; Second circle
G0 X100 Y90 Z1.4 F3000
G2 X100 Y90 Z1.4 I0 J10 E90.0 F500

; End
M104 S0 ; Turn off hotend
M140 S0 ; Turn off bed
G0 X0 Y200 Z10 F3000 ; Move head away
M84 ; Disable motors
